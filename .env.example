# ==============================================================================
# RentoAI / NetraCare - Global Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to:
#   - backend/.env (for FastAPI service)
#   - frontend/.env.local (for Next.js application)
#
# IMPORTANT: Never commit actual passwords, private keys, or API tokens.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & CORS CONFIGURATION (Backend)
# ------------------------------------------------------------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=dr_screening
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SESSION CONFIGURATION (Shared: Backend & Frontend)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify HS256 JWT tokens. Must match across backend and frontend.
# Generate a secure random string (e.g., openssl rand -base64 32):
AUTH_SECRET=your_jwt_auth_secret_minimum_32_characters_long

# Session Cookie Configuration
SESSION_COOKIE_NAME=dr_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE=86400

# ------------------------------------------------------------------------------
# 3. FRONTEND & BACKEND URL ROUTING
# ------------------------------------------------------------------------------
# Frontend origin (default Next.js dev port)
FRONTEND_ORIGIN=http://localhost:3000

# Backend URL accessed by Next.js server-side rewrites/proxies
BACKEND_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. MATLAB PIPELINE RUNTIME INTEGRATION (Backend)
# ------------------------------------------------------------------------------
# Path to local MATLAB executable (MATLAB R2026a or compatible)
MATLAB_EXECUTABLE=C:\Program Files\MATLAB\R2026a\bin\matlab.exe

# Path to MATLAB workstream root folder containing runPipeline.m (defaults to ../Matlab)
# MATLAB_ROOT=C:\Users\username\RentoAI\Matlab

# Maximum timeout in seconds before terminating a running MATLAB subprocess (default 180s)
MATLAB_TIMEOUT_SECONDS=180

# ------------------------------------------------------------------------------
# 5. GOOGLE OAUTH 2.0 (Optional / Integration)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/backend/auth/oauth/google/callback

# ------------------------------------------------------------------------------
# 6. OTP EMAIL NOTIFICATIONS (Optional / Brevo or standard SMTP)
# ------------------------------------------------------------------------------
# Brevo REST API v3 key starting with xkeysib- (from Brevo Dashboard -> Transactional -> API Keys)
BREVO_API_KEY=your_brevo_v3_api_key_xkeysib_here

# Legacy SMTP server configuration (fallback if BREVO_API_KEY is omitted)
EMAIL_SERVER_HOST=smtp-relay.brevo.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_smtp_login_user@example.com
EMAIL_SERVER_PASSWORD=your_smtp_password_here
EMAIL_FROM="NetraCare Screening <noreply@example.com>"
# Set SMTP_DISABLED=1 to disable SMTP and force terminal OTP logging in dev/test
# SMTP_DISABLED=1

# ------------------------------------------------------------------------------
# 7. LLM CLINICAL ASSISTANT (Optional / Gemini)
# ------------------------------------------------------------------------------
# Used for plain-language patient explanations. Falls back to clinical templates if unset.
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
