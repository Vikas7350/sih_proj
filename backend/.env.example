MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=dr_screening
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10
AUTH_SECRET=your_nextauth_secret_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Must match the "Authorized redirect URI" set in Google Cloud Console for the
# OAuth client. Browser goes through here after picking a Google account.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/backend/auth/oauth/google/callback
# FRONTEND_ORIGIN=http://localhost:3000

# Session cookie (httpOnly, backend-issued JWT). False in dev, true in production.
# SESSION_COOKIE_NAME=dr_token
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# LLM layer (optional): patient-friendly explanation + precautions on
# POST /api/screenings/{id}/ai-explanation. Falls back to a deterministic
# template when unset or on API failure. Any of these env names works.
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# OTP email (Brevo or any SMTP). If left unset in development, OTPs are logged
# to the backend terminal instead of sent.
# Set SMTP_DISABLED=1 to force the terminal-fallback even when EMAIL_SERVER_* are set
# (useful for dev/tests so they never hit the real SMTP server).
# If EMAIL_SERVER_* are set but SMTP rejects login, signup returns HTTP 502 with a
# clear error instead of silently "succeeding".
# Brevo REST API v3 Key (starts with xkeysib-). Takes precedence over SMTP fallback.
# BREVO_API_KEY=your_brevo_v3_api_key_xkeysib_here

EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="NetraCare <noreply@example.com>"
# SMTP_DISABLED=1
