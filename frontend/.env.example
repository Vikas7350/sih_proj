# Shared HS256 JWT secret — MUST match backend/.env AUTH_SECRET exactly.
# Backend signs its session JWT with it; middleware + server components verify the cookie.
AUTH_SECRET=your_auth_secret_here

# How the cookie is named by the backend (optional; default dr_token)
# SESSION_COOKIE_NAME=dr_token

# Google OAuth (optional) — same client id as backend/.env GOOGLE_CLIENT_ID
# The id_token is verified by the BACKEND; this id is only used to start the flow.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Backend API URL (FastAPI)
BACKEND_URL=http://localhost:8000